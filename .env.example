# SMTP credentials used by the /contact form (app/contact/actions.ts).
# Copy this file to .env.local for local development, and add the same
# variables in your hosting provider's environment settings for production.
#
# Common providers (use the mailbox's own login):
#   Google Workspace: SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  SMTP_PASS=<16-char App Password>
#   Zoho Mail:        SMTP_HOST=smtp.zoho.in     SMTP_PORT=465  (smtp.zoho.com for non-India accounts)
#   Hostinger:        SMTP_HOST=smtp.hostinger.com SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=connect@genovaatechlabs.com
SMTP_PASS=

# Optional: sender address (defaults to SMTP_USER) and recipient (defaults to connect@genovaatechlabs.com)
MAIL_FROM=
CONTACT_TO=
